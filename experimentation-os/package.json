{
  "name": "experimentos",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:console": "pnpm --filter @experimentos/console dev",
    "dev:host": "pnpm --filter @experimentos/host-app dev",
    "format": "biome format --write frontend examples packages",
    "format:check": "biome format frontend examples packages",
    "lint": "biome lint frontend examples packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "openapi:generate": "uv run --project backend python scripts/export_openapi.py && openapi-typescript backend/openapi.json -o packages/api-client/src/schema.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
