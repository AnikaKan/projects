{
  "name": "checkoutiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/init-db.mjs",
    "db:seed": "node --env-file=.env --experimental-strip-types scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "test": "DATABASE_URL=file:./test.db node scripts/init-db.mjs --reset && DATABASE_URL=file:./test.db vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.19.1",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.1": true,
    "@prisma/engines@6.19.1": true,
    "prisma@6.19.1": true
  }
}
