# Backend-only. Never prefix with VITE_ (that would expose it to the browser bundle).
SARVAM_API_KEY=
# Optional overrides (defaults shown). Verified against docs.sarvam.ai on 2026-10-28.
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER_EN=ishita
SARVAM_SPEAKER_HI=priya
SARVAM_SPEAKER_TE=neha
PORT=8787
# Directory for cached TTS audio of standard (non-personal) lesson text
TTS_CACHE_DIR=server/.cache/tts

# ── AI explanations (Anthropic Claude) ── backend-only, never VITE_-prefixed.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown). Verified against platform.claude.com docs on 2026-10-28.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_MS=9000
CLAUDE_MAX_RETRIES=0
CLAUDE_MAX_TOKENS=700
# Leave empty for https://api.anthropic.com (ANTHROPIC_BASE_URL from the shell is deliberately ignored)
CLAUDE_API_BASE_URL=
