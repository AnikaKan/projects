{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "i18n:export": "jiti scripts/i18n.ts export",
    "i18n:import": "jiti scripts/i18n.ts import",
    "server": "node server/index.mjs",
    "serve": "node server/index.mjs --static",
    "audio:pregen": "jiti scripts/pregen-audio.ts",
    "eval:sarvam": "jiti scripts/eval-sarvam.ts",
    "ai:pack": "jiti scripts/ai-pack.ts",
    "eval:claude": "node scripts/eval-claude.mjs",
    "eval": "jiti tests/evals/run.ts",
    "eval:llm": "jiti tests/evals/llm.ts",
    "typecheck:evals": "tsc -p tsconfig.evals.json --noEmit",
    "eval:holdout": "jiti tests/evals/run.ts --holdout",
    "eval:holdout2": "jiti tests/evals/run.ts --holdout2",
    "eval:holdout3": "jiti tests/evals/run.ts --holdout3",
    "eval:holdout4": "jiti tests/evals/run.ts --holdout4",
    "test:e2e": "node tests/e2e/run-all.cjs",
    "eval:consistency": "jiti tests/evals/consistency.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/noto-sans": "^5.1.1",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.1.1",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
